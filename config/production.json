{
  "server": {
    "http": { "enabled": false },
    "https": { "enabled": true, "port": 3443, "redirectAllHttpToHttps": true }
  },
  "db": { "uri": "mongodb://localhost:27017/media_prod" },
  "security": {
    "jwt": {
      "secret": "use-env-secret",
      "expiresIn": "24h"
    },
    "cors": {
      "origins": [
        "https://localhost:3443",
        "https://127.0.0.1:3443"
      ]
    },
    "rateLimit": { "windowMs": 900000, "max": 50 }
  }
}